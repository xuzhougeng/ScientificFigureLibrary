{
  "name": "scientific-figure-library",
  "version": "0.5.5",
  "description": "A portable MCP server and MCP App for searching, importing, and materializing scientific figure templates.",
  "type": "module",
  "bin": {
    "scientific-figure-library": "dist/index.js"
  },
  "files": [
    ".wisp-plugin",
    ".codex-plugin",
    ".claude-plugin",
    ".mcp.json",
    "assets",
    "docs",
    "dist",
    "skills",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/esbuild-server.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "package:source-pack": "node scripts/package-source-pack.mjs",
    "package:npm": "npm run build && node -e \"require('node:fs').mkdirSync('release',{recursive:true})\" && npm pack --pack-destination release",
    "package:wisp": "npm run build && node scripts/package-wisp.mjs",
    "start": "node dist/index.js",
    "version:check": "node scripts/check-version-sync.mjs",
    "version:set": "node scripts/version-set.mjs",
    "test": "node scripts/check-version-sync.mjs && node --test tests/*.test.ts",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "check": "npm run test && npm run test:smoke",
    "package:codex": "npm run build && node scripts/package-codex.mjs",
    "package:claude": "npm run build && node scripts/package-claude.mjs",
    "package:plugins": "npm run build && node scripts/package-wisp.mjs && node scripts/package-codex.mjs && node scripts/package-claude.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.19.5",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "zod": "^4.1.13"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuzhougeng/ScientificFigureLibrary"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.0"
  }
}
