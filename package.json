{
  "name": "scientific-figure-library",
  "version": "0.6.2",
  "description": "Local-first MCP server and MCP App for your scientific figures: import, review, and publish a global library on disk, then reuse exact templates in Claude Science and Wisp Science.",
  "keywords": [
    "scientific-figures",
    "figure-library",
    "local-first",
    "figure-templates",
    "mcp",
    "mcp-app",
    "claude-science",
    "wisp-science",
    "visualization",
    "publication-figures",
    "reproducible-research"
  ],
  "homepage": "https://xuzhougeng.github.io/ScientificFigureLibrary/",
  "type": "module",
  "bin": {
    "scientific-figure-library": "dist/index.js"
  },
  "files": [
    ".wisp-plugin",
    ".codex-plugin",
    ".claude-plugin",
    "assets",
    "docs/GLOBAL_LIBRARY_0.6.md",
    "docs/PROTOCOL.md",
    "dist",
    "skills",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/esbuild-server.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "package:source-pack": "node scripts/package-source-pack.mjs",
    "package:npm": "node scripts/release-preflight.mjs && npm run build && node scripts/package-npm.mjs",
    "package:wisp": "node scripts/release-preflight.mjs && npm run build && node scripts/package-wisp.mjs",
    "start": "node dist/index.js",
    "version:check": "node scripts/check-version-sync.mjs",
    "version:set": "node scripts/version-set.mjs",
    "test": "node scripts/check-version-sync.mjs && node --test tests/*.test.ts",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "check": "npm run test && npm run test:smoke",
    "package:codex": "node scripts/release-preflight.mjs && npm run build && node scripts/package-codex.mjs",
    "package:claude": "node scripts/release-preflight.mjs && npm run build && node scripts/package-claude.mjs",
    "package:plugins": "node scripts/package-plugins.mjs",
    "community:sync": "node scripts/sync-community.mjs",
    "modules:validate": "node scripts/validate-personal-modules.mjs",
    "modules:archive": "node scripts/archive-personal-modules.mjs",
    "modules:catalog": "node scripts/build-personal-module-catalog.mjs",
    "modules:source-pack": "node scripts/package-personal-module-source-pack.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.19.5",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "zod": "^4.1.13"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuzhougeng/ScientificFigureLibrary"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.0"
  },
  "author": "xuzhougeng and jarxunlai"
}
